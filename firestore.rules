rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções Auxiliares de Segurança e Validação de Tipos
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidPositiveNumber(val) {
      return val is number && val >= 0;
    }

    function isValidNumber(val) {
      return val is number;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidYearMonth(val) {
      return val is string && val.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function isValidFortnight(val) {
      return val is number && (val == 1 || val == 2);
    }

    // Validador de Perfil do Usuário com Restrição Estrita de Campos e RBAC
    function isValidUserProfile(data) {
      return data.keys().hasOnly([
        'uid', 'id', 'email', 'displayName', 'photoURL',
        'role', 'plan', 'planStatus', 'planExpiresAt', 'gracePeriodExpiresAt',
        'asaasCustomerId', 'asaasSubscriptionId',
        'preferences', 'createdAt', 'updatedAt',
        'inactivatedAt', 'inactivationReason',
        'scheduledPlan', 'scheduledPlanDate'
      ])
        && (!('displayName' in data) || isValidString(data.displayName, 1, 100))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1500))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200))
        && (!('role' in data) || data.role in ['admin', 'user'])
        && (!('plan' in data) || data.plan in ['free', 'pro', 'duo'])
        && (!('planStatus' in data) || data.planStatus in ['active', 'canceled', 'past_due', 'trial'])
        && (!('planExpiresAt' in data) || data.planExpiresAt == null || data.planExpiresAt is string)
        && (!('gracePeriodExpiresAt' in data) || data.gracePeriodExpiresAt == null || data.gracePeriodExpiresAt is string)
        && (!('asaasCustomerId' in data) || data.asaasCustomerId == null || data.asaasCustomerId is string)
        && (!('asaasSubscriptionId' in data) || data.asaasSubscriptionId == null || data.asaasSubscriptionId is string)
        && (!('scheduledPlan' in data) || data.scheduledPlan == null || data.scheduledPlan in ['free', 'pro', 'duo'])
        && (!('scheduledPlanDate' in data) || data.scheduledPlanDate == null || data.scheduledPlanDate is string)
        && (!('inactivatedAt' in data) || data.inactivatedAt == null || data.inactivatedAt is string)
        && (!('inactivationReason' in data) || data.inactivationReason == null || data.inactivationReason is string);
    }

    // Validador de Ciclo Mensal com Suporte a Renda, Totais e Regime Salarial
    function isValidMonthlyCycle(data) {
      return data.keys().hasOnly(['id', 'mesAno', 'renda_quinzena_1', 'renda_quinzena_2', 'total_renda', 'total_gastos', 'saldo_final', 'regime_salarial', 'dia_pagamento', 'descricao_dia_pagamento', 'createdAt', 'updatedAt'])
        && (!('renda_quinzena_1' in data) || isValidPositiveNumber(data.renda_quinzena_1))
        && (!('renda_quinzena_2' in data) || isValidPositiveNumber(data.renda_quinzena_2))
        && (!('total_renda' in data) || isValidPositiveNumber(data.total_renda))
        && (!('total_gastos' in data) || isValidPositiveNumber(data.total_gastos))
        && (!('saldo_final' in data) || isValidNumber(data.saldo_final))
        && (!('mesAno' in data) || isValidYearMonth(data.mesAno))
        && (!('regime_salarial' in data) || data.regime_salarial in ['quinzenal', 'mensal_q1', 'mensal_q2', 'divisao_50_50', 'mensal_unico']);
    }

    // Validador de Despesa / Renda Extra com Suporte a Parcelamentos, Recorrências e Comprovantes
    function isValidExpense(data) {
      return data.keys().hasOnly([
        'id', 'descricao', 'valor', 'categoria', 'quinzena', 'mesAno',
        'status_pagamento', 'tipo', 'codigo_comprovante', 'data_vencimento',
        'recorrente', 'recorrente_id', 'parcela_atual', 'total_parcelas', 'grupo_parcela_id',
        'isParcelado', 'grupoParcelamentoId', 'numeroParcela', 'totalParcelas',
        'observacao', 'observacoes', 'createdAt', 'updatedAt'
      ])
        && isValidPositiveNumber(data.valor)
        && isValidString(data.descricao, 1, 100)
        && (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 50))
        && (!('quinzena' in data) || isValidFortnight(data.quinzena))
        && (!('mesAno' in data) || isValidYearMonth(data.mesAno))
        && (!('status_pagamento' in data) || data.status_pagamento is bool)
        && (!('tipo' in data) || data.tipo in ['despesa', 'renda_extra'])
        && (!('codigo_comprovante' in data) || data.codigo_comprovante == null || (data.codigo_comprovante is string && data.codigo_comprovante.size() <= 100));
    }

    // Validador de Despesas Recorrentes (Contas Fixas)
    function isValidRecurringExpense(data) {
      return data.keys().hasOnly([
        'id', 'descricao', 'valor', 'categoria', 'quinzena',
        'data_vencimento', 'ativo', 'observacao', 'observacoes',
        'createdAt', 'updatedAt'
      ])
        && isValidPositiveNumber(data.valor)
        && isValidString(data.descricao, 1, 100)
        && (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 50))
        && (!('quinzena' in data) || isValidFortnight(data.quinzena))
        && (!('ativo' in data) || data.ativo is bool);
    }

    // Validador de Tributos Anuais
    function isValidTax(data) {
      return data.keys().hasOnly([
        'id', 'titulo', 'nome', 'ano', 'ano_referencia', 'valor_orcado',
        'valor_pago', 'data_vencimento', 'data_pagamento', 'status',
        'observacao', 'observacoes', 'createdAt', 'updatedAt'
      ])
        && (!('titulo' in data) || isValidString(data.titulo, 1, 100))
        && (!('nome' in data) || isValidString(data.nome, 1, 100))
        && (!('valor_orcado' in data) || isValidPositiveNumber(data.valor_orcado))
        && (!('valor_pago' in data) || isValidPositiveNumber(data.valor_pago));
    }

    // Validador de Viagens e Gastos Coletivos
    function isValidTravel(data) {
      return data.keys().hasOnly([
        'id', 'titulo', 'nome', 'destino', 'numPessoas', 'quantidade_participantes',
        'data_inicio', 'data_fim', 'moeda', 'total', 'total_gastos',
        'valor_por_pessoa', 'itens', 'despesas', 'participantes',
        'createdAt', 'updatedAt'
      ])
        && (!('titulo' in data) || isValidString(data.titulo, 1, 100))
        && (!('nome' in data) || isValidString(data.nome, 1, 100))
        && (!('total' in data) || isValidPositiveNumber(data.total))
        && (!('total_gastos' in data) || isValidPositiveNumber(data.total_gastos))
        && (!('quantidade_participantes' in data) || (data.quantidade_participantes is number && data.quantidade_participantes >= 1 && data.quantidade_participantes <= 100));
    }

    // Validador de Caixinha / Reserva de Emergência Figurativa (CARD-068)
    function isValidCaixinha(data) {
      return data.keys().hasOnly([
        'id', 'userId', 'saldo', 'meta', 'nome', 'createdAt', 'updatedAt'
      ])
        && isValidPositiveNumber(data.saldo)
        && (!('userId' in data) || isValidString(data.userId, 1, 100))
        && (!('meta' in data) || data.meta == null || isValidPositiveNumber(data.meta))
        && (!('nome' in data) || (data.nome is string && data.nome.size() <= 100));
    }

    // Validador de Movimentação da Caixinha (Aporte / Resgate)
    function isValidCaixinhaMovimentacao(data) {
      return data.keys().hasOnly([
        'id', 'caixinhaId', 'userId', 'tipo', 'valor', 'data',
        'observacao', 'mesAnoDestino', 'quinzenaDestino', 'createdAt'
      ])
        && data.tipo in ['aporte', 'resgate']
        && isValidPositiveNumber(data.valor) && data.valor > 0
        && (!('quinzenaDestino' in data) || isValidFortnight(data.quinzenaDestino))
        && (!('mesAnoDestino' in data) || isValidYearMonth(data.mesAnoDestino))
        && (!('observacao' in data) || data.observacao == null || (data.observacao is string && data.observacao.size() <= 200));
    }

    // Validador de Grupos do Plano Duo / Casal
    function isValidDuoGroup(data) {
      return data.keys().hasOnly([
        'id', 'ownerId', 'ownerEmail', 'ownerName', 'partnerId',
        'partnerEmail', 'partnerName', 'inviteCode', 'status',
        'createdAt', 'updatedAt'
      ])
        && isValidString(data.ownerId, 1, 100)
        && isValidString(data.inviteCode, 4, 20)
        && data.status in ['pending', 'active', 'cancelled'];
    }

    // Validador de Despesas Compartilhadas do Casal (Nossos Gastos)
    function isValidSharedExpense(data) {
      return data.keys().hasOnly([
        'id', 'descricao', 'valorTotal', 'categoria', 'quinzena', 'mesAno',
        'pagoPorId', 'pagoPorNome', 'tipoDivisao', 'valorOwner', 'valorPartner',
        'status_pagamento', 'isParcelado', 'parcelaAtual', 'totalParcelas',
        'grupoParcelamentoId', 'codigoComprovante', 'observacao', 'observacoes',
        'data_vencimento', 'tipo', 'recorrente', 'ativo',
        'members', 'createdAt', 'updatedAt'
      ])
        && isValidPositiveNumber(data.valorTotal)
        && isValidString(data.descricao, 1, 100)
        && (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 50))
        && (!('quinzena' in data) || isValidFortnight(data.quinzena))
        && (!('mesAno' in data) || isValidYearMonth(data.mesAno))
        && (!('status_pagamento' in data) || data.status_pagamento is bool)
        && (!('pagoPorId' in data) || isValidString(data.pagoPorId, 1, 100))
        && (!('pagoPorNome' in data) || isValidString(data.pagoPorNome, 1, 100))
        && (!('tipoDivisao' in data) || data.tipoDivisao in ['50_50', 'personalizado', '100_titular', '100_parceiro'])
        && (!('valorOwner' in data) || isValidPositiveNumber(data.valorOwner))
        && (!('valorPartner' in data) || isValidPositiveNumber(data.valorPartner))
        && (!('isParcelado' in data) || data.isParcelado is bool)
        && (!('parcelaAtual' in data) || data.parcelaAtual is number)
        && (!('totalParcelas' in data) || data.totalParcelas is number)
        && (!('grupoParcelamentoId' in data) || data.grupoParcelamentoId == null || data.grupoParcelamentoId is string)
        && (!('codigoComprovante' in data) || data.codigoComprovante == null || data.codigoComprovante is string)
        && (!('observacao' in data) || data.observacao == null || data.observacao is string)
        && (!('observacoes' in data) || data.observacoes == null || data.observacoes is string)
        && (!('data_vencimento' in data) || data.data_vencimento == null || (data.data_vencimento is string && data.data_vencimento.size() <= 30))
        && (!('tipo' in data) || data.tipo in ['despesa', 'compartilhado', 'renda_extra'])
        && (!('recorrente' in data) || data.recorrente is bool)
        && (!('ativo' in data) || data.ativo is bool)
        && data.members is list
        && data.members.size() >= 1 && data.members.size() <= 2;
    }

    // Regras para Grupos do Plano Casal / Duo
    match /duo_groups/{groupId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.partnerId ||
        resource.data.status == 'pending'
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId && isValidDuoGroup(request.resource.data);
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId ||
        (resource.data.status == 'pending' && request.auth.uid == request.resource.data.partnerId) ||
        request.auth.uid == resource.data.partnerId
      ) && isValidDuoGroup(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;

      // Despesas Compartilhadas do Casal (Subcoleção por ciclo)
      match /ciclos/{mesAno}/despesas_compartilhadas/{despesaId} {
        allow read: if isAuthenticated() && (request.auth.uid in resource.data.members || resource.data.members.hasAny([request.auth.uid]));
        allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members && isValidSharedExpense(request.resource.data);
        allow update: if isAuthenticated() && request.auth.uid in resource.data.members && request.auth.uid in request.resource.data.members && isValidSharedExpense(request.resource.data);
        allow delete: if isAuthenticated() && request.auth.uid in resource.data.members;
      }
    }

    // Configurações Globais do Sistema e Gateway Asaas (Acesso restrito a administradores e Cloud Functions)
    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Auditoria e Eventos de Sistema / Webhooks (Leitura restrita a administradores e escrita exclusiva de backend)
    match /system_events/{allEvents=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Isolamento Estrito de Dados por Usuário e Governança Administrativa
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && isValidUserProfile(request.resource.data)
                        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
                        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
                        && (!('asaasSubscriptionId' in request.resource.data) || request.resource.data.asaasSubscriptionId == null)
                       )
                     || isAdmin();
      allow update: if (isOwner(userId) && isValidUserProfile(request.resource.data)
                        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || (!('role' in resource.data) && request.resource.data.role == 'user'))
                        && (!('plan' in request.resource.data) || request.resource.data.plan == resource.data.plan || (!('plan' in resource.data) && request.resource.data.plan == 'free'))
                        && (!('planStatus' in request.resource.data) || request.resource.data.planStatus == resource.data.planStatus || (!('planStatus' in resource.data) && request.resource.data.planStatus == 'active'))
                        && (!('asaasSubscriptionId' in request.resource.data) || request.resource.data.asaasSubscriptionId == resource.data.asaasSubscriptionId || (!('asaasSubscriptionId' in resource.data) && request.resource.data.asaasSubscriptionId == null))
                       )
                     || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      // Despesas Recorrentes (Contas Fixas Mensais)
      match /despesas_recorrentes/{recorrenteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidRecurringExpense(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Ciclos Mensais
      match /ciclos_mensais/{mesAno} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMonthlyCycle(request.resource.data);
        allow delete: if isOwner(userId);

        // Despesas e Rendas Extras do Ciclo
        match /despesas/{despesaId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidExpense(request.resource.data);
          allow delete: if isOwner(userId);
        }
      }

      // Tributos Anuais e Parcelamentos
      match /tributos_e_parcelas/{tributoId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTax(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Gastos de Viagem e Rateio
      match /viagens/{viagemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTravel(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // Caixinha / Reserva de Emergência Figurativa (CARD-068)
      match /caixinhas/{caixinhaId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCaixinha(request.resource.data);
        allow delete: if isOwner(userId);

        // Movimentações de Aporte e Resgate da Caixinha
        match /movimentacoes/{movId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidCaixinhaMovimentacao(request.resource.data);
          allow update, delete: if false; // Imutabilidade de histórico de movimentação
        }
      }

      // Bloqueio de subcoleções não modeladas (Fechamento do Catch-all de segurança)
      match /{allSubcollections=**} {
        allow read, write: if false;
      }
    }
  }
}

