# ==============================================================================
# CONTROLE DE GASTOS - VARIÁVEIS DE AMBIENTE DAS CLOUD FUNCTIONS (BACKEND)
# ==============================================================================
# Copie este arquivo para .env na pasta functions/ e preencha seus valores reais.
# O arquivo .env é ignorado pelo Git e nunca deve ser versionado publicamente.

# --- Integração com Bot do Telegram (Feedbacks & Avisos de Erro) ---
# Token fornecido pelo @BotFather no Telegram (ex: 1234567890:AAFlkJHGfdSA987-xyz123abc)
TELEGRAM_BOT_TOKEN="SEU_TOKEN_AQUI"

# ID do chat ou grupo para onde as notificações serão enviadas (obtido via @userinfobot)
TELEGRAM_CHAT_ID="SEU_CHAT_ID_AQUI"

# --- Integração de Pagamentos Asaas (Opcional se configurado via Firestore) ---
# Token de webhook para validação HMAC/Header
ASAAS_WEBHOOK_SECRET=""
